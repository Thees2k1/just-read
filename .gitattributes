# Automatically detect text files and normalize them to LF
* text=auto eol=lf

# Explicit text formats
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.xml     text eol=lf
*.toml    text eol=lf
*.py      text eol=lf
*.dart    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.kt      text eol=lf
*.kts     text eol=lf
*.rs      text eol=lf
*.sh      text eol=lf
*.ps1     text eol=lf

# Windows-specific scripts that may require CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files: never perform line-ending conversion
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.jar     binary
*.apk     binary
*.aab     binary
*.exe     binary
*.dll     binary
*.so      binary
*.woff    binary
*.woff2   binary
